node_modules/

# Build output — regenerated by `npm run build`, not source
dist/

# Digest content — lives on whichever machine runs the build; the deploy
# pipeline reads it straight off disk and never depends on git for it
digests/

# Local Claude Code tooling (plugins, skills) — not application source
.claude/
.agents/
skills-lock.json

# Firebase CLI local state
.firebase/
firebase-debug.log*

.DS_Store
.env*
