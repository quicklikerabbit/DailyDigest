<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Keeps `npm run watch:deploy` running in the background: starts at login
     and restarts if it exits, so new digests deploy without a terminal open. -->
<!-- Template: install.sh fills in the __PLACEHOLDERS__ for this machine. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.dailydigest.watch-deploy</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NPM__</string>
    <string>run</string>
    <string>watch:deploy</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO_DIR__</string>
  <!-- launchd doesn't load the shell profile, so npm/node (nvm) and firebase
       (Homebrew) need their directories on PATH explicitly. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__PATH__</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__LOG_DIR__/watch-deploy.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/watch-deploy.log</string>
</dict>
</plist>
